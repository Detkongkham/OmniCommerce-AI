{
  "name": "oca",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "OmniCommerce AI - social commerce & omnichannel platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:local": "pnpm --filter @oca/dev-infra start",
    "db:seed": "pnpm --filter @oca/database db:seed"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
