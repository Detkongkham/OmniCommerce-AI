  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@oca/config": "workspace:*",
    "@types/node": "^26.6.4",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
