# Database & cache (ກົງກັບ docker-compose.yml)
# ຖ້າພອດ 5432/6379 ຖືກໃຊ້ແລ້ວ ໃຫ້ປ່ຽນ POSTGRES_PORT/REDIS_PORT ແລະ ແກ້ DATABASE_URL/REDIS_URL ໃຫ້ກົງກັນ
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://oca:oca@localhost:5432/oca
# OCA_TEST_DB=oca_test_mybranch  # ຖ້າຮັນ test ຂະໜານກັບ session/worktree ອື່ນ ໃຫ້ໃຊ້ຊື່ຖານແຍກ
REDIS_URL=redis://localhost:6379

# API (apps/api)
PORT=3001
# ຢ່າງໜ້ອຍ 32 ໂຕອັກສອນ; ສ້າງດ້ວຍ: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me-0123456789
CORS_ORIGIN=http://localhost:3000
# Path ຂອງ cookie refresh token (default /auth). Admin ເອີ້ນ API ຜ່ານ proxy /api ຈຶ່ງຕ້ອງເປັນ /api/auth
# ຕ້ອງເປັນ /auth (ຫຼືບໍ່ຕັ້ງຄ່າ) ຖ້າເອີ້ນ API ໂດຍກົງ ໂດຍບໍ່ຜ່ານ proxy /api ຂອງ admin
REFRESH_COOKIE_PATH=/api/auth

# Worker (apps/worker)
QUEUE_PREFIX=oca
WORKER_CONCURRENCY=5

# Slip verification
# ໂຟເດີເກັບຮູບສະລິບ (API ແລະ worker ຕ້ອງຊີ້ໄປບ່ອນດຽວກັນ; ໃນ production ໃຊ້ volume ຮ່ວມ ແລະ path ແບບ absolute)
# path ແບບ relative ຖືກຕີຄວາມຈາກ cwd ຂອງ process (apps/api ແລະ apps/worker) ຈຶ່ງໃຊ້ ../../ ໃຫ້ຊີ້ root ຂອງ repo ຄືກັນທັງສອງ
SLIP_STORAGE_DIR=../../.data/slips
# fake = ບໍ່ໃຊ້ AI (ແອດມິນຕື່ມຄ່າມື). reader ຈິງຈະເພີ່ມໃນຂັ້ນ 2
SLIP_READER=fake
# ສະເພາະ SLIP_READER=fake: ຜົນອ່ານຈຳລອງ ເຊັ່ນ {"amount":"100000","currency":"LAK","refNo":"R1"}
SLIP_FAKE_RESULT=

# Seed: ຜູ້ໃຊ້ OWNER ຄົນທຳອິດ (ປ່ຽນລະຫັດຜ່ານກ່ອນໃຊ້ຈິງ; ຢ່າງໜ້ອຍ 8 ໂຕອັກສອນ)
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-please
# Seed: ຊື່ຮ້ານເລີ່ມຕົ້ນ (ບໍ່ຂຽນທັບຖ້າມີ StoreSetting ແລ້ວ)
SEED_STORE_NAME=OCA Store

# AI
GEMINI_API_KEY=

# Storage (Cloudflare R2 / AWS S3)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Social channels
# ສຳຮອງໄວ້ (reserved): ຍັງບໍ່ຖືກອ່ານ/ບໍ່ໄດ້ໃຊ້; ຮັກສາ key ໄວ້
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# Page Access Token ຂອງເພຈ (ຕອບແຊັດ + ດຶງຊື່ລູກຄ້າ). ບໍ່ຕັ້ງ = ຕອບບໍ່ໄດ້ (ຂໍ້ຄວາມຂາອອກ FAILED/CHANNEL_NOT_CONFIGURED)
FACEBOOK_PAGE_ACCESS_TOKEN=
# dev/simulator only; never set in production
# ຊີ້ໄປ simulator ໃນ dev (ເຊັ່ນ http://127.0.0.1:4010); ບໍ່ຕັ້ງ = https://graph.facebook.com/v21.0
FACEBOOK_GRAPH_BASE_URL=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Notifications
TELEGRAM_BOT_TOKEN=
